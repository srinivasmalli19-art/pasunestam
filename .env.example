# Copy this file to .env.local and fill in your Supabase dev project's
# Settings > API values, then restart `npm run dev`. See PLAYBOOK.md Part 1.3.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phase 4 (AI certificate-template import). Server-only — never expose with
# a NEXT_PUBLIC_ prefix. Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Phase 8 (email + monitoring). Optional until you're getting close to launch.
RESEND_API_KEY=
SENTRY_DSN=

# Copy this file to .env.local and fill in your Firebase project's values,
# then restart `npm run dev`. See README.md for exactly where to find each one.

# From the Firebase console: Project settings > General > Your apps > Web app.
# This key is meant to be public (Firebase's own abuse protection covers it),
# used only to call the Identity Toolkit REST API for sign-in/sign-up.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# From the downloaded service account JSON: Project settings > Service accounts
# > Generate new private key. Server-only — never expose with NEXT_PUBLIC_.
# Paste the "private_key" value as-is; its \n sequences are handled for you.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Storage bucket for uploaded scheme forms. Defaults to
# "<project-id>.firebasestorage.app" (the current Firebase default) if unset.
FIREBASE_STORAGE_BUCKET=

# Developing against the Firebase Local Emulator Suite instead of a real
# project? Set these two and the app + scripts/seed-templates.ts talk to the
# emulators automatically — the four vars above can be left blank.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Phase 4 (AI certificate-template import). Server-only. Get a key at
# https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Phase 8 (email + monitoring). Optional until you're getting close to launch.
RESEND_API_KEY=
SENTRY_DSN=

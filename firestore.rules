rules_version = '2';

// This app never reads or writes Firestore from the browser — every read and
// write goes through Server Components/Actions using firebase-admin, which
// bypasses these rules entirely (the same trust boundary the old Postgres
// `security definer` functions gave us). So the correct default here is
// simply to deny all client-side access. If a future feature ever needs
// direct client access (e.g. a real-time listener), carve out that specific
// collection here rather than loosening this default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
